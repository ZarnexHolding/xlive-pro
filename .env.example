# ─────────────────────────────────────────────────────────────────────────────
# XLIVE enquiry automation — environment variables
#
# Copy to `.env` for local `vercel dev`, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
#
# ⚠️  Dashboard values are LITERAL — do NOT wrap them in quotes. A quoted
#     CONTACT_FROM becomes an invalid sender and Resend rejects with a 502.
#     Quotes belong only in a .env *file*. Editing env vars needs a redeploy.
#
# NEVER put real secrets in this example file — placeholders only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO=hello@xlive-pro.com
# Verified sender. Before verifying the domain in Resend, use:
#   CONTACT_FROM=XLIVE <onboarding@resend.dev>
CONTACT_FROM=XLIVE Production <hello@xlive-pro.com>

# ── Database (Neon serverless Postgres) ──────────────────────────────────────
# Neon → project → Connection string (pooled). Works on Vercel AND Cloudflare.
# If unset, the app runs in an in-memory fallback (enquiries are NOT persisted).
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ── Notification behaviour / feature flags ───────────────────────────────────
# test  → WhatsApp is mocked (logged, never really sent). Safe default.
# live  → WhatsApp really sends (requires the Meta credentials below).
NOTIFICATIONS_MODE=test
EMAIL_NOTIFICATIONS_ENABLED=true
TEAM_WHATSAPP_ENABLED=true
CUSTOMER_WHATSAPP_ENABLED=true

# ── Abuse protection ─────────────────────────────────────────────────────────
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=10
MAX_MESSAGE_LENGTH=5000

# ── Admin / debug endpoint (GET /api/enquiries) ──────────────────────────────
# Long random string. If unset, the endpoint is disabled (returns 404).
ADMIN_API_TOKEN=

# ── WhatsApp (Meta Cloud API) — NOT YET CONFIGURED ───────────────────────────
# Leave blank for now. While these are blank (or NOTIFICATIONS_MODE=test) the
# WhatsApp service uses its mock adapter, so nothing real is sent.
# Obtain from Meta: developers.facebook.com → your app → WhatsApp.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v22.0
# You choose this string; it must match what you enter in Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
# App secret — enables X-Hub-Signature-256 verification on inbound webhooks.
WHATSAPP_APP_SECRET=
# Comma-separated E.164 numbers that receive the internal team alert.
WHATSAPP_TEAM_RECIPIENTS=+9665XXXXXXXX
# Approved template names (business-initiated messages require templates).
WHATSAPP_CUSTOMER_ACK_TEMPLATE=
WHATSAPP_TEAM_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# In test mode, redirect ALL WhatsApp messages here instead of real recipients.
WHATSAPP_TEST_RECIPIENT=
